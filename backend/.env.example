# HustleAI Environment Configuration Example
# Copy this file to .env and configure as needed.

APP_NAME=HustleAI
DEBUG=True
DATABASE_URL=sqlite:///./hustleai.db

# JWT Secret for session authentication (change in production)
JWT_SECRET=your_super_secret_production_key_here_change_me

# Open-Source AI Settings
# Default Mode: "local" (privacy first, zero cloud leakage) or "remote" (explicit opt-in)
DEFAULT_AI_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.2:3b

# Optional Remote Provider (only used when user explicitly enables Remote Mode in settings)
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_API_KEY=
DEFAULT_REMOTE_MODEL=gpt-4o-mini
