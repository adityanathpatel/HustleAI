# ==============================================================================
# HustleAI - Global Environment Configuration
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') for local development.
# NEVER commit your actual '.env' file or production secrets to Git.
# ==============================================================================

# Backend Server Configuration
APP_NAME=HustleAI
DEBUG=True
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./hustleai.db

# JWT Secret for Session Authentication
# In production, generate a secure random 64-character secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_production_secret_key_here

# Open-Source AI Engine Configuration
# Modes: "local" (default, 100% air-gapped on-device) or "remote" (explicit opt-in)
DEFAULT_AI_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.2:3b

# Optional Remote Provider (only used when user explicitly enables Remote Mode in settings)
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_API_KEY=
DEFAULT_REMOTE_MODEL=gpt-4o-mini

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000
